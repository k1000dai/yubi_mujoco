include LICENSE README.md CHANGELOG.md CONTRIBUTING.md pyproject.toml uv.lock .python-version
recursive-include src/yubi_mujoco *.py *.json *.md *.stl *.txt py.typed
recursive-include tests *.py
recursive-include examples *.py *.json
recursive-include docs *.md
recursive-include cad *.py *.md *.STEP LICENSE
recursive-include scripts *.py
prune .github
prune build
prune dist
prune yubi-output
prune .venv
prune .pytest_cache
prune .ruff_cache
global-exclude __pycache__ *.py[cod] .DS_Store
